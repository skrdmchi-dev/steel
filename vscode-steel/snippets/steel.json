{
  "Function Declaration": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) {",
      "    $0",
      "}"
    ],
    "description": "Declare a Steel function"
  },
  "Class Declaration": {
    "prefix": "class",
    "body": [
      "class ${1:ClassName} {",
      "    init(${2:params}) {",
      "        this.${3:field} = ${2:params}",
      "    }",
      "}"
    ],
    "description": "Declare a Steel class with constructor"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:pattern} => ${3:print(\"Matched\")},",
      "    _ => ${0:print(\"Default\")}",
      "}"
    ],
    "description": "Steel pattern matching block"
  },
  "Unit Test Block": {
    "prefix": "test",
    "body": [
      "test \"${1:should work}\" {",
      "    assert(${0:true}, \"Assertion failed\")",
      "}"
    ],
    "description": "Steel unit test block (run with `steel test`)"
  },
  "For Range Loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "    $0",
      "}"
    ],
    "description": "Steel range for-loop"
  }
}
