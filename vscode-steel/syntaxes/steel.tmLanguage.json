{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Steel",
  "scopeName": "source.steel",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.steel",
          "match": "//.*$"
        },
        {
          "name": "comment.block.steel",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.steel",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.steel",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.steel",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.steel" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.steel" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.steel",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.steel",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
