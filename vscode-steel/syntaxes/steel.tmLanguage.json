{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Steel",
  "scopeName": "source.steel",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.steel",
          "match": "//.*$"
        },
        {
          "name": "comment.block.steel",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.steel",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.steel",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.steel",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.steel" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.steel" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.steel",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.steel",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.steel",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.steel",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.steel",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.class.steel" },
            "2": { "name": "entity.name.type.class.steel" },
            "3": { "name": "keyword.other.extends.steel" },
            "4": { "name": "entity.other.inherited-class.steel" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.steel" },
            "2": { "name": "entity.name.function.steel" }
          }
        },
        {
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.new.steel" },
            "2": { "name": "entity.name.type.class.steel" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.steel",
          "match": "\\b(if|else|while|for|in|break|continue|return|match|try|catch|throw|import|test|defer)\\b"
        },
        {
          "name": "storage.type.steel",
          "match": "\\b(let|const|fn|class|extends|enum)\\b"
        },
        {
          "name": "constant.language.boolean.steel",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.steel",
          "match": "\\b(null|nil)\\b"
        },
        {
          "name": "variable.language.this.steel",
          "match": "\\b(this|self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "(:|->)\\s*(num|str|bool|array|map|any|void|null)\\b",
          "captures": {
            "1": { "name": "keyword.operator.type.annotation.steel" },
            "2": { "name": "support.type.primitive.steel" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.steel",
          "match": "\\b(print|println|input|assert|type|str|num|len|push|pop|keys|values|contains|range|slice|reverse|sort|map|filter|reduce|split|join|trim|upper|lower|replace|abs|floor|ceil|round|sqrt|pow|min|max|sin|cos|clamp|atan2|log|exp|sign|sum|avg|unique|flat|enumerate|zip|json_parse|json_stringify|args|env|set_env|cwd|exec|exit|file_exists|list_dir|make_dir|remove_file|append_file|sleep|random|rand_int|hash|uuid|read_file|write_file|clock|init)\\b"
        },
        {
          "name": "support.constant.math.steel",
          "match": "\\b(PI|E)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.steel",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.steel",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.range.steel",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.null-coalesce.steel",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.assignment.compound.steel",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.comparison.steel",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.steel",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.steel",
          "match": "\\*\\*|\\+|-|\\*|/|%"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.steel" }
          }
        }
      ]
    }
  }
}
