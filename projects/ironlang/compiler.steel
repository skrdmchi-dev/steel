// IronLang Recursive-Descent Parser, Bytecode Compiler & Jump-Safe Peephole Optimizer
// Compiles IronLang syntax (let, =, if/else/end, while/end, print, full precedence) to VM bytecode

fn find_or_add_var(syms, name) {
    let i = 0
    let n = len(syms)
    while i < n {
        if syms[i] == name {
            return i
        }
        i = i + 1
    }
    push(syms, name)
    return n
}

fn is_number_tok(tok) {
    if tok == 0 { return 1 }
    if tok == "let" || tok == "if" || tok == "else" || tok == "while" || tok == "end" || tok == "print" {
        return 0
    }
    if tok == "+" || tok == "-" || tok == "*" || tok == "/" || tok == "%" { return 0 }
    if tok == "==" || tok == "!=" || tok == "<" || tok == ">" || tok == "<=" || tok == ">=" { return 0 }
    if tok == "=" || tok == "(" || tok == ")" || tok == ";" { return 0 }
    // Numeric tokens are stored as actual numbers in the token stream
    if (tok + 0) == tok {
        return 1
    }
    return 0
}

fn parse_primary(tokens, state, syms, code) {
    let pos = state[0]
    let tok = tokens[pos]

    if tok == "(" {
        state[0] = pos + 1
        parse_cmp(tokens, state, syms, code)
        if state[0] < len(tokens) && tokens[state[0]] == ")" {
            state[0] = state[0] + 1
        }
        return 0
    }

    if tok == "-" {
        state[0] = pos + 1
        parse_primary(tokens, state, syms, code)
        push(code, 19)
        return 0
    }

    state[0] = pos + 1
    if is_number_tok(tok) == 1 {
        push(code, 1)
        push(code, tok)
    } else {
        let slot = find_or_add_var(syms, tok)
        push(code, 3)
        push(code, slot)
    }
    return 0
}

fn parse_mul(tokens, state, syms, code) {
    parse_primary(tokens, state, syms, code)
    while state[0] < len(tokens) {
        let op = tokens[state[0]]
        if op == "*" {
            state[0] = state[0] + 1
            parse_primary(tokens, state, syms, code)
            push(code, 7)
        } else if op == "/" {
            state[0] = state[0] + 1
            parse_primary(tokens, state, syms, code)
            push(code, 8)
        } else if op == "%" {
            state[0] = state[0] + 1
            parse_primary(tokens, state, syms, code)
            push(code, 9)
        } else {
            return 0
        }
    }
    return 0
}

fn parse_add(tokens, state, syms, code) {
    parse_mul(tokens, state, syms, code)
    while state[0] < len(tokens) {
        let op = tokens[state[0]]
        if op == "+" {
            state[0] = state[0] + 1
            parse_mul(tokens, state, syms, code)
            push(code, 5)
        } else if op == "-" {
            state[0] = state[0] + 1
            parse_mul(tokens, state, syms, code)
            push(code, 6)
        } else {
            return 0
        }
    }
    return 0
}

fn parse_cmp(tokens, state, syms, code) {
    parse_add(tokens, state, syms, code)
    while state[0] < len(tokens) {
        let op = tokens[state[0]]
        if op == "==" {
            state[0] = state[0] + 1
            parse_add(tokens, state, syms, code)
            push(code, 10)
        } else if op == "<" {
            state[0] = state[0] + 1
            parse_add(tokens, state, syms, code)
            push(code, 11)
        } else if op == ">" {
            state[0] = state[0] + 1
            parse_add(tokens, state, syms, code)
            push(code, 12)
        } else if op == "<=" {
            state[0] = state[0] + 1
            parse_add(tokens, state, syms, code)
            push(code, 13)
        } else if op == ">=" {
            state[0] = state[0] + 1
            parse_add(tokens, state, syms, code)
            push(code, 14)
        } else if op == "!=" {
            state[0] = state[0] + 1
            parse_add(tokens, state, syms, code)
            push(code, 15)
        } else {
            return 0
        }
    }
    return 0
}

fn parse_block(tokens, state, syms, code) {
    let total = len(tokens)
    while state[0] < total {
        let tok = tokens[state[0]]

        if tok == "end" || tok == "else" {
            return 0
        }

        if tok == ";" {
            state[0] = state[0] + 1
        } else if tok == "let" {
            // let <name> = <expr>
            let var_name = tokens[state[0] + 1]
            let slot = find_or_add_var(syms, var_name)
            state[0] = state[0] + 3
            parse_cmp(tokens, state, syms, code)
            push(code, 4)
            push(code, slot)
        } else if tok == "print" {
            // print <expr>
            state[0] = state[0] + 1
            parse_cmp(tokens, state, syms, code)
            push(code, 18)
        } else if tok == "if" {
            // if <cond> <then-block> [else <else-block>] end
            state[0] = state[0] + 1
            parse_cmp(tokens, state, syms, code)
            push(code, 17)
            let jz_patch = len(code)
            push(code, 0)

            parse_block(tokens, state, syms, code)

            if state[0] < total && tokens[state[0]] == "else" {
                state[0] = state[0] + 1
                push(code, 16)
                let jmp_patch = len(code)
                push(code, 0)
                code[jz_patch] = len(code)
                parse_block(tokens, state, syms, code)
                code[jmp_patch] = len(code)
            } else {
                code[jz_patch] = len(code)
            }

            if state[0] < total && tokens[state[0]] == "end" {
                state[0] = state[0] + 1
            }
        } else if tok == "while" {
            // while <cond> <body> end
            let loop_start = len(code)
            state[0] = state[0] + 1
            parse_cmp(tokens, state, syms, code)
            push(code, 17)
            let exit_patch = len(code)
            push(code, 0)

            parse_block(tokens, state, syms, code)

            push(code, 16)
            push(code, loop_start)
            code[exit_patch] = len(code)

            if state[0] < total && tokens[state[0]] == "end" {
                state[0] = state[0] + 1
            }
        } else {
            // Assignment: <name> = <expr>
