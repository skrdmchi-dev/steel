// IronLang ISA — Opcodes & Bytecode Disassembler
// Part of the IronLang Programming Language written in Steel

fn op_name(op) {
    if op == 1 { return "PUSH" }
    if op == 2 { return "POP" }
    if op == 3 { return "LOAD" }
    if op == 4 { return "STORE" }
    if op == 5 { return "ADD" }
    if op == 6 { return "SUB" }
    if op == 7 { return "MUL" }
    if op == 8 { return "DIV" }
    if op == 9 { return "MOD" }
    if op == 10 { return "EQ" }
    if op == 11 { return "LT" }
    if op == 12 { return "GT" }
    if op == 13 { return "LTE" }
    if op == 14 { return "GTE" }
    if op == 15 { return "NEQ" }
    if op == 16 { return "JMP" }
    if op == 17 { return "JZ" }
    if op == 18 { return "PRINT" }
    if op == 19 { return "NEG" }
    if op == 20 { return "HALT" }
    return "UNKNOWN"
}

fn has_operand(op) {
    if op == 1 { return 1 }
    if op == 3 { return 1 }
    if op == 4 { return 1 }
    if op == 16 { return 1 }
    if op == 17 { return 1 }
    return 0
}

fn disassemble(code, label) {
    print("  --- Disassembly:", label, "(", len(code), "words ) ---")
    let ip = 0
    let n = len(code)
    while ip < n {
        let op = code[ip]
        let name = op_name(op)
        if has_operand(op) == 1 {
            let arg = code[ip + 1]
            if op == 3 || op == 4 {
                print("   ", ip, ":", name, "v" + arg)
            } else if op == 16 || op == 17 {
                print("   ", ip, ":", name, "-> @" + arg)
            } else {
                print("   ", ip, ":", name, arg)
            }
            ip = ip + 2
        } else {
            print("   ", ip, ":", name)
            ip = ip + 1
        }
    }
    return 0
}
