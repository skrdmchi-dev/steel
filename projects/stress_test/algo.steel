// Stress Test Module 1: Algorithms, Recursion, Classes, Closures, Math

fn quicksort(arr) {
    if len(arr) <= 1 {
        return arr
    }
    let pivot = arr[0]
    let less = []
    let greater = []
    let i = 1
    while i < len(arr) {
        if arr[i] <= pivot {
            push(less, arr[i])
        } else {
            push(greater, arr[i])
        }
        i = i + 1
    }
    let left_sorted = quicksort(less)
    let right_sorted = quicksort(greater)
    let out = []
    for x in left_sorted {
        push(out, x)
    }
    push(out, pivot)
    for y in right_sorted {
        push(out, y)
    }
    return out
}

fn ackermann(m, n) {
    if m == 0 {
        return n + 1
    }
    if n == 0 {
        return ackermann(m - 1, 1)
    }
    return ackermann(m - 1, ackermann(m, n - 1))
}

fn gcd(a, b) {
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

class BankAccount {
    init(owner, balance) {
        this.owner = owner
        this.balance = balance
    }
    deposit(amt) {
        this.balance = this.balance + amt
        return this.balance
    }
    withdraw(amt) {
        if amt > this.balance {
            return -1
        }
        this.balance = this.balance - amt
        return this.balance
    }
}
