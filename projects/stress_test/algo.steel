fn quicksort(arr) {
    if len(arr) <= 1 {
        return arr
    }
    let pivot = arr[0]
    let less = []
    let greater = []
    let i = 1
    while i < len(arr) {
        if arr[i] <= pivot {
            push(less, arr[i])
        } else {
            push(greater, arr[i])
        }
        i = i + 1
    }
    let left_sorted = quicksort(less)
    let right_sorted = quicksort(greater)
    let out = []
    for x in left_sorted {
        push(out, x)
    }
    push(out, pivot)
    for y in right_sorted {
        push(out, y)
    }
    return out
}

