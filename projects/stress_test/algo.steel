fn quicksort(arr) {
    if len(arr) <= 1 {
        return arr
    }
    let pivot = arr[0]
    let less = []
    let greater = []
    let i = 1
    while i < len(arr) {
        if arr[i] <= pivot {
            push(less, arr[i])
        } else {
            push(greater, arr[i])
        }
        i = i + 1
