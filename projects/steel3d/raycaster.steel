// Casts a 3D ray from (px, py) at angle `ray_angle` and returns perpendicular
// distance to the nearest wall (or negative distance if it hits the Exit Portal!)
fn cast_ray(px: num, py: num, ray_angle: num) -> num {
    let dx = cos(ray_angle)
    let dy = sin(ray_angle)
    let dist = 0.05
    let step = 0.08

